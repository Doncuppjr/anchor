From e38dfcf943d29bd1ceb5659866d92ff5b8ed300e Mon Sep 17 00:00:00 2001
From: ANCHOR development <anchor-dev@localhost>
Date: Fri, 27 Nov 2026 02:15:51 +0000
Subject: [PATCH] Add opt-in hardware UART DFU transport for ANCHOR

---
 CMakeLists.txt                              |  9 ++-
 lib/sdk/components/libraries/hci/hci_slip.c | 22 +++++++-
 src/boards/anchor/board.cmake               |  2 +
 src/boards/anchor/board.h                   | 62 +++++++++++++++++++++
 src/boards/anchor/pinconfig.c               | 19 +++++++
 src/main.c                                  | 24 +++++++-
 src/sdk_config.h                            |  8 +++
 7 files changed, 142 insertions(+), 4 deletions(-)
 create mode 100644 src/boards/anchor/board.cmake
 create mode 100644 src/boards/anchor/board.h
 create mode 100644 src/boards/anchor/pinconfig.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2677d45..94b54d2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -222,7 +222,11 @@ if (TRACE_ETM STREQUAL "1")
   target_compile_definitions(bootloader PUBLIC ENABLE_TRACE)
 endif ()
 
-if (MCU_VARIANT STREQUAL "nrf52")
+if (ENABLE_UART_DFU)
+  target_compile_definitions(bootloader PUBLIC ENABLE_UART_DFU)
+endif ()
+
+if (MCU_VARIANT STREQUAL "nrf52" OR ENABLE_UART_DFU)
   # UART transport
   target_sources(bootloader PUBLIC
     ${SDK_DIR}/libraries/uart/app_uart.c
@@ -234,7 +238,8 @@ if (MCU_VARIANT STREQUAL "nrf52")
     ${SDK_DIR}/drivers_nrf/common
     ${SDK_DIR}/drivers_nrf/uart
     )
-else ()
+endif ()
+if (NOT MCU_VARIANT STREQUAL "nrf52")
   # USB transport
   target_sources(bootloader PUBLIC
     src/boards/${BOARD}/pinconfig.c
diff --git a/lib/sdk/components/libraries/hci/hci_slip.c b/lib/sdk/components/libraries/hci/hci_slip.c
index f7673f6..bb7aaf3 100644
--- a/lib/sdk/components/libraries/hci/hci_slip.c
+++ b/lib/sdk/components/libraries/hci/hci_slip.c
@@ -47,6 +47,9 @@
 // nRF has native usb peripheral
 #ifdef NRF_USBD
 #include "tusb.h"
+#ifdef ENABLE_UART_DFU
+extern bool uart_dfu_selected;
+#endif
 #endif
 
 #define APP_SLIP_END        0xC0                            /**< SLIP code for identifying the beginning and end of a packet frame.. */
@@ -126,6 +129,9 @@ uint32_t (*send_tx_byte) (void) = send_tx_byte_default;
 
 static uint32_t serial_put(char ch)
 {
+  #ifdef ENABLE_UART_DFU
+  if (uart_dfu_selected) return app_uart_put(ch);
+  #endif
   return tud_cdc_write_char(ch) ? NRF_SUCCESS : NRF_ERROR_NO_MEM;
 }
 
@@ -352,8 +358,14 @@ static bool rx_buffer_overflowed(void)
 
 #ifdef NRF_USBD
 
+#ifdef ENABLE_UART_DFU
+static uint32_t physical_uart_open(void);
+#endif
 static uint32_t slip_uart_open(void)
 {
+#ifdef ENABLE_UART_DFU
+  if (uart_dfu_selected) return physical_uart_open();
+#endif
   m_current_state = SLIP_READY;
   return NRF_SUCCESS;
 }
@@ -367,7 +379,8 @@ void tud_cdc_rx_cb(uint8_t port)
   }
 }
 
-#else
+#endif
+#if !defined(NRF_USBD) || defined(ENABLE_UART_DFU)
 
 /** @brief Function for handling the UART module event. It parses events from the UART when
  *         bytes are received/transmitted.
@@ -390,7 +403,11 @@ static void slip_uart_eventhandler(app_uart_evt_t * uart_event)
 
 /** @brief Function for enabling the UART module when the SLIP layer is opened.
  */
+#ifdef NRF_USBD
+static uint32_t physical_uart_open(void)
+#else
 static uint32_t slip_uart_open(void)
+#endif
 {
     uint32_t err_code;
 
@@ -448,6 +465,9 @@ uint32_t hci_slip_close()
     m_current_state   = SLIP_OFF;
 
 #ifdef NRF_USBD
+#ifdef ENABLE_UART_DFU
+    if (uart_dfu_selected) return app_uart_close();
+#endif
     return NRF_SUCCESS;
 #else
     uint32_t err_code = app_uart_close();
diff --git a/src/boards/anchor/board.cmake b/src/boards/anchor/board.cmake
new file mode 100644
index 0000000..89585b0
--- /dev/null
+++ b/src/boards/anchor/board.cmake
@@ -0,0 +1,2 @@
+set(MCU_VARIANT nrf52840)
+set(ENABLE_UART_DFU ON)
