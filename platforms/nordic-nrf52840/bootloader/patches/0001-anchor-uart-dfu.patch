diff --git a/src/boards/anchor/pinconfig.c b/src/boards/anchor/pinconfig.c
new file mode 100644
index 0000000..a983e4a
--- /dev/null
+++ b/src/boards/anchor/pinconfig.c
@@ -0,0 +1,19 @@
+#include "boards.h"
+#include "uf2/configkeys.h"
+
+__attribute__((used, section(".bootloaderConfig")))
+const uint32_t bootloaderConfig[] =
+{
+  /* CF2 START */
+  CFG_MAGIC0, CFG_MAGIC1,                       // magic
+  5, 100,                                       // used entries, total entries
+
+  204, 0x100000,                                // FLASH_BYTES = 0x100000
+  205, 0x40000,                                 // RAM_BYTES = 0x40000
+  208, (USB_DESC_VID << 16) | USB_DESC_UF2_PID, // BOOTLOADER_BOARD_ID = USB VID+PID, used for verification when updating bootloader via uf2
+  209, 0xada52840,                              // UF2_FAMILY = 0xada52840
+  210, 0x20,                                    // PINS_PORT_SIZE = PA_32
+
+  0, 0, 0, 0, 0, 0, 0, 0
+  /* CF2 END */
+};
diff --git a/src/main.c b/src/main.c
index c988ee4..08d2337 100644
--- a/src/main.c
+++ b/src/main.c
@@ -133,6 +133,9 @@ uint32_t* dbl_reset_mem = ((uint32_t*) DFU_DBL_RESET_MEM);
 
 // true if ble, false if serial
 bool _ota_dfu = false;
+#ifdef ENABLE_UART_DFU
+bool uart_dfu_selected = false;
+#endif
 bool _ota_connected = false;
 bool _ota_was_connected = false;
 bool _sd_inited = false;
@@ -258,6 +261,11 @@ static void check_dfu_mode(void) {
   bool dfu_start = _ota_dfu || serial_only_dfu || uf2_dfu ||
                    (((*dbl_reset_mem) == DFU_DBL_RESET_MAGIC) && reason_reset_pin);
 
+  #ifdef ENABLE_UART_DFU
+  uart_dfu_selected = (gpregret == 0x59);
+  dfu_start = dfu_start || uart_dfu_selected;
+  #endif
+
   // Clear GPREGRET if it is our values
   if (dfu_start || dfu_skip) {
     NRF_POWER->GPREGRET = 0;
@@ -328,12 +336,23 @@ static void check_dfu_mode(void) {
       if (!_sd_inited) mbr_init_sd();
       _sd_inited = true;
       ble_stack_init();
-    } else {
+    }
+#ifdef ENABLE_UART_DFU
+    else if (uart_dfu_selected) {
+      led_state(STATE_USB_MOUNTED);
+    }
+#endif
+    else {
       led_state(STATE_USB_UNMOUNTED);
       usb_init(serial_only_dfu);
     }
 
     // Initiate an update of the firmware.
+#ifdef ENABLE_UART_DFU
+    if (uart_dfu_selected) {
+      bootloader_dfu_start(false, 10000, false);
+    } else
+#endif
     if (APP_ASKS_FOR_SINGLE_TAP_RESET() || uf2_dfu || serial_only_dfu) {
       // If USB is not enumerated in 3s (eg. because we're running on battery), we restart into app.
       bootloader_dfu_start(_ota_dfu, 3000, true);
@@ -345,6 +364,9 @@ static void check_dfu_mode(void) {
     if (_ota_dfu) {
       disable_softdevice();
     } else {
+#ifdef ENABLE_UART_DFU
+      if (!uart_dfu_selected)
+#endif
       usb_teardown();
     }
   }
diff --git a/src/sdk_config.h b/src/sdk_config.h
index b61b1f0..7556d60 100644
--- a/src/sdk_config.h
+++ b/src/sdk_config.h
@@ -49,11 +49,19 @@
 #define HCI_SLIP_ENABLED                   1
 
 #define HCI_UART_BAUDRATE                  UART_BAUDRATE_BAUDRATE_Baud115200
+#ifdef ENABLE_UART_DFU
+#define HCI_UART_FLOW_CONTROL 0
+#define HCI_UART_RX_PIN ANCHOR_UART_RX
+#define HCI_UART_TX_PIN ANCHOR_UART_TX
+#define HCI_UART_CTS_PIN 0xffffffffu
+#define HCI_UART_RTS_PIN 0xffffffffu
+#else
 #define HCI_UART_FLOW_CONTROL              HWFC
 #define HCI_UART_RX_PIN                    RX_PIN_NUMBER
 #define HCI_UART_TX_PIN                    TX_PIN_NUMBER
 #define HCI_UART_CTS_PIN                   CTS_PIN_NUMBER
 #define HCI_UART_RTS_PIN                   RTS_PIN_NUMBER
+#endif
 
 #define HCI_TRANSPORT_ENABLED              1
 #define HCI_MAX_PACKET_SIZE_IN_BITS        8000
