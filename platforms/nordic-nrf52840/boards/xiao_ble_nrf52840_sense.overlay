#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
&pinctrl {
    anchor_led_pwm: anchor_led_pwm {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
                    <NRF_PSEL(PWM_OUT1, 0, 30)>,
                    <NRF_PSEL(PWM_OUT2, 0, 6)>;
            nordic,invert;
        };
    };
    anchor_led_pwm_sleep: anchor_led_pwm_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
                    <NRF_PSEL(PWM_OUT1, 0, 30)>,
                    <NRF_PSEL(PWM_OUT2, 0, 6)>;
            low-power-enable;
        };
    };
};
&pwm0 {
    status = "okay";
    pinctrl-0 = <&anchor_led_pwm>;
    pinctrl-1 = <&anchor_led_pwm_sleep>;
    pinctrl-names = "default", "sleep";
};
